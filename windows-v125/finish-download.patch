diff --git a/windows/tests/test_completion_125.py b/windows/tests/test_completion_125.py
new file mode 100644
index 0000000..80cfbea
--- /dev/null
+++ b/windows/tests/test_completion_125.py
@@ -0,0 +1,126 @@
+"""Regression tests for 100% progress, postprocessing and stuck process teardown."""
+from __future__ import annotations
+
+import io
+from pathlib import Path
+import subprocess
+import sys
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+import worker as engine
+from core import Choice
+from worker import DownloadWorker, Job
+
+
+def make_job(tmp_path, playlist=False):
+    return Job(1001, "https://example.org/test", "clip", Choice("Auto", "best"), tmp_path, playlist)
+
+
+def test_100_percent_is_not_completion_before_file_is_finalized(tmp_path):
+    dw = DownloadWorker(lambda *x: None, start_thread=False)
+    j = make_job(tmp_path)
+    assert dw._apply_line(j, "TKPROGRESS| 100.0%|20MiB|20MiB|3MiB/s|00:00")
+    assert j.progress == 100 and j.status != "Готово"
+    assert "обработка и сохранение" in j.phase
+    assert not j.speed and not j.eta
+
+
+def test_after_move_clears_speed_eta_and_deduplicates_path(tmp_path):
+    dw = DownloadWorker(lambda *x: None, start_thread=False)
+    j = make_job(tmp_path)
+    final = tmp_path / "sample.mp4"
+    final.write_bytes(b"video")
+    dw._apply_line(j, "TKPROGRESS|99%|1MiB|1MiB|1MiB/s|00:01")
+    dw._apply_line(j, f"TKDONE|{final}")
+    dw._apply_line(j, f"TKDONE|{final}")
+    assert (j.speed, j.eta) == ("", "")
+    assert dw._verify_saved_files(j) == (True, "Сохранено файлов: 1")
+
+
+def test_hung_process_after_confirmed_file_becomes_finished(tmp_path, monkeypatch):
+    media = tmp_path / "Ролик.mp4"
+    media.write_bytes(b"mock media with nonzero byte length")
+    class HangingProcess:
+        def __init__(self):
+            self.stdout = io.StringIO("TKPROGRESS| 100.0%|3MiB|3MiB|3MiB/s|00:00\n"+f"TKDONE|{media}\n")
+            self.running = True
+            self.wait_called = 0
+        def poll(self):
+            return None if self.running else 1
+        def wait(self, timeout=None):
+            self.wait_called += 1
+            if self.running:
+                raise subprocess.TimeoutExpired("yt-dlp", timeout)
+            return 1
+        def kill(self):
+            self.running = False
+    process = HangingProcess()
+    monkeypatch.setattr(engine, "tools", lambda: {"yt-dlp":Path("yt-dlp.exe"), "ffmpeg":None, "deno":None})
+    monkeypatch.setattr(engine.subprocess, "Popen", lambda *args, **kwargs: process)
+    monkeypatch.setattr(engine.DownloadWorker, "_stop_process_tree", staticmethod(lambda p: p.kill()))
+    dw = DownloadWorker(lambda *x: None, start_thread=False)
+    dw.completion_grace_seconds = 0.01
+    j = make_job(tmp_path)
+    dw.enqueue(j)
+    dw._run(j)
+    assert j.status == "Готово", (j.status, j.last_error, j.log_tail)
+    assert j.progress == 100
+    assert "зависший процесс остановлен" in j.phase
+    assert process.running is False
+    assert (j.speed, j.eta) == ("", "")
+
+
+def test_hang_without_final_file_does_not_fake_success(tmp_path, monkeypatch):
+    class HangingProcess:
+        def __init__(self):
+            self.stdout = io.StringIO("TKPROGRESS| 100.0%|3MiB|3MiB|2MiB/s|00:00\n")
+            self.running = True
+        def poll(self):
+            return None if self.running else -1
+        def wait(self, timeout=None):
+            if self.running:
+                raise subprocess.TimeoutExpired("yt-dlp", timeout)
+            return -1
+        def kill(self):
+            self.running = False
+    process = HangingProcess()
+    monkeypatch.setattr(engine, "tools", lambda: {"yt-dlp":Path("yt-dlp.exe"), "ffmpeg":None, "deno":None})
+    monkeypatch.setattr(engine.subprocess, "Popen", lambda *args, **kwargs: process)
+    monkeypatch.setattr(engine.DownloadWorker, "_stop_process_tree", staticmethod(lambda p: p.kill()))
+    dw = DownloadWorker(lambda *x: None, start_thread=False)
+    dw.completion_grace_seconds = 0.01
+    j = make_job(tmp_path)
+    dw.enqueue(j)
+    dw._run(j)
+    assert j.status == "Ошибка"
+    assert j.progress == 100  # Received 100%, but not a confirmed completed media file.
+
+
+def test_stale_saved_files_from_previous_run_not_accepted(tmp_path, monkeypatch):
+    old = tmp_path / "old.mp4"
+    old.write_bytes(b"old")
+    class CompletedWithoutFile:
+        def __init__(self):self.stdout = io.StringIO("[download] 100%\n")
+        def poll(self):return 0
+        def wait(self, timeout=None):return 0
+    monkeypatch.setattr(engine, "tools", lambda: {"yt-dlp":Path("yt-dlp.exe"), "ffmpeg":None, "deno":None})
+    monkeypatch.setattr(engine.subprocess, "Popen", lambda *args, **kwargs: CompletedWithoutFile())
+    dw = DownloadWorker(lambda *x: None, start_thread=False)
+    j = make_job(tmp_path)
+    j.saved_files.append(old)
+    dw.enqueue(j)
+    dw._run(j)
+    assert j.status == "Ошибка" and not j.saved_files
+
+
+def test_playlist_terminal_marker_is_separate_from_each_video(tmp_path):
+    from core import download_arguments
+    dw = DownloadWorker(lambda *x: None, start_thread=False)
+    j = make_job(tmp_path, playlist=True)
+    dw._apply_line(j, "TKITEM|1|2|First")
+    dw._apply_line(j, "TKDONE|first.mp4")
+    assert j.progress == 0.0 and "Сохранено" in j.phase
+    dw._apply_line(j, "TKPLAYLISTEND|2")
+    assert "Плейлист обработан" in j.phase
+    args = download_arguments(Path("yt-dlp.exe"), j.url, j.choice, tmp_path, True)
+    assert "playlist:TKPLAYLISTEND|%(playlist_count)s" in args